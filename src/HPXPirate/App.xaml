<Application x:Class="HPXPirate.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:HPXPirate.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global glow effect used by the BOOST button -->
            <DropShadowEffect x:Key="BoostGlow" Color="#FFFF2BD6" BlurRadius="38" ShadowDepth="0" Opacity="0.9" />
            <DropShadowEffect x:Key="SoftGlow" Color="#FF8A5CFF" BlurRadius="18" ShadowDepth="0" Opacity="0.5" />

            <!-- Converters -->
            <conv:PercentToBrushConverter x:Key="PercentToBrush" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:StatusToBrushConverter x:Key="StatusToBrush" />
            <conv:HexToBrushConverter x:Key="HexToBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
