<UserControl x:Class="HPXPirate.Views.CrosshairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             FontFamily="{StaticResource Font.Primary}">

    <UserControl.Resources>
        <Style x:Key="CtrlLabel" TargetType="TextBlock" BasedOn="{StaticResource MetricLabel}" />
        <DataTemplate x:Key="ColorSwatch">
            <StackPanel Orientation="Horizontal">
                <Border Width="16" Height="16" CornerRadius="4" Margin="0,0,8,0"
                        Background="{Binding Converter={StaticResource HexToBrush}}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" />
                <TextBlock Text="{Binding}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Crosshair Overlay" Style="{StaticResource H1}" />
            <TextBlock Text="A pure visual overlay drawn on top of your screen. Click-through, never reads game data, never affects input."
                       Style="{StaticResource Caption}" Margin="0,2,0,16" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Controls -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Enable crosshair" IsChecked="{Binding Enabled}" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="SHAPE" Style="{StaticResource CtrlLabel}" />
                                <ComboBox Style="{StaticResource HpxCombo}" Margin="0,6,0,0"
                                          ItemsSource="{Binding Shapes}" SelectedItem="{Binding Shape}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,12">
                                <TextBlock Text="COLOR" Style="{StaticResource CtrlLabel}" />
                                <ComboBox Style="{StaticResource HpxCombo}" Margin="0,6,0,0"
                                          ItemsSource="{Binding Colors}" SelectedItem="{Binding Color}"
                                          ItemTemplate="{StaticResource ColorSwatch}" />
                            </StackPanel>

                            <StackPanel Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="SIZE" Style="{StaticResource CtrlLabel}" />
                                <TextBlock Text="{Binding Size, StringFormat={}{0:0}}" Style="{StaticResource Mono}" />
                                <Slider Style="{StaticResource HpxSlider}" Minimum="2" Maximum="40" Value="{Binding Size}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,12">
                                <TextBlock Text="THICKNESS" Style="{StaticResource CtrlLabel}" />
                                <TextBlock Text="{Binding Thickness, StringFormat={}{0:0}}" Style="{StaticResource Mono}" />
                                <Slider Style="{StaticResource HpxSlider}" Minimum="1" Maximum="8" Value="{Binding Thickness}" />
                            </StackPanel>

                            <StackPanel Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="GAP" Style="{StaticResource CtrlLabel}" />
                                <TextBlock Text="{Binding Gap, StringFormat={}{0:0}}" Style="{StaticResource Mono}" />
                                <Slider Style="{StaticResource HpxSlider}" Minimum="0" Maximum="30" Value="{Binding Gap}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,12">
                                <TextBlock Text="OPACITY" Style="{StaticResource CtrlLabel}" />
                                <TextBlock Text="{Binding Opacity, StringFormat={}{0:0.00}}" Style="{StaticResource Mono}" />
                                <Slider Style="{StaticResource HpxSlider}" Minimum="0.1" Maximum="1" Value="{Binding Opacity}" />
                            </StackPanel>

                            <StackPanel Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="OFFSET X" Style="{StaticResource CtrlLabel}" />
                                <TextBlock Text="{Binding OffsetX, StringFormat={}{0:0}}" Style="{StaticResource Mono}" />
                                <Slider Style="{StaticResource HpxSlider}" Minimum="-200" Maximum="200" Value="{Binding OffsetX}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,12">
                                <TextBlock Text="OFFSET Y" Style="{StaticResource CtrlLabel}" />
                                <TextBlock Text="{Binding OffsetY, StringFormat={}{0:0}}" Style="{StaticResource Mono}" />
                                <Slider Style="{StaticResource HpxSlider}" Minimum="-200" Maximum="200" Value="{Binding OffsetY}" />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,4,0,0">
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Center dot" IsChecked="{Binding CenterDot}" Margin="0,0,20,10" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Outline" IsChecked="{Binding Outline}" Margin="0,0,20,10" />
                        </WrapPanel>

                        <TextBlock Text="TOGGLE HOTKEY" Style="{StaticResource CtrlLabel}" Margin="0,10,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Style="{StaticResource HpxTextBox}" Width="160" Text="{Binding ToggleHotkey}" />
                            <Button Style="{StaticResource GhostButton}" Content="Register" Margin="10,0,0,0"
                                    Command="{Binding ApplyHotkeyCommand}" />
                        </StackPanel>
                        <TextBlock Text="Example: F8, Ctrl+Alt+C. Hotkey works globally while HPX PIRATE runs."
                                   Style="{StaticResource Caption}" Margin="0,6,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="SHOW" Command="{Binding ShowCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Hide" Margin="10,0,0,0" Command="{Binding HideCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Toggle" Margin="10,0,0,0" Command="{Binding ToggleCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="SAVE" Margin="10,0,0,0" Command="{Binding SaveCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Preview -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="LIVE PREVIEW" Style="{StaticResource MetricLabel}" />
                        <Border Height="260" Margin="0,10,0,0" CornerRadius="12" Background="#FF0A0812"
                                BorderBrush="{StaticResource Brush.Border.Glow}" BorderThickness="1" ClipToBounds="True">
                            <Canvas x:Name="PreviewCanvas" Background="Transparent" />
                        </Border>
                        <TextBlock Text="Preview is approximate. The real overlay is drawn full-screen and click-through."
                                   Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="STATUS" Style="{StaticResource MetricLabel}" />
                        <TextBlock Style="{StaticResource BaseText}" Margin="0,6,0,0">
                            <Run Text="Overlay:" Foreground="{StaticResource Brush.Text.Secondary}" />
                            <Run Text="{Binding IsOverlayVisible, Mode=OneWay}" Foreground="{StaticResource Brush.Accent.Cyan}" />
                        </TextBlock>
                        <TextBlock Text="Fair-play: this overlay only draws a shape on your screen. It does not detect enemies, lock aim, or read game memory."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
