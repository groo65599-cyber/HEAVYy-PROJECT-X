<UserControl x:Class="HPXPirate.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:HPXPirate.Controls"
             FontFamily="{StaticResource Font.Primary}">

    <UserControl.Resources>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinWidth" Value="158" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,28">
        <StackPanel>

            <!-- Header -->
            <TextBlock Text="Dashboard" Style="{StaticResource H1}" />
            <TextBlock Text="Live system and game performance overview. Everything is measured, nothing is faked."
                       Style="{StaticResource Caption}" Margin="0,2,0,18" />

            <!-- Boost + status -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="HPX PERFORMANCE ENGINE" Style="{StaticResource MetricLabel}" />
                        <Button Style="{StaticResource BoostButton}" Content="BOOST NOW" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Command="{Binding BoostCommand}" />
                        <TextBlock Text="{Binding BoostSummary}" Style="{StaticResource Caption}" Margin="0,14,0,0" />

                        <ItemsControl ItemsSource="{Binding BoostSteps}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{Binding Success, Converter={StaticResource StatusToBrush}}"
                                                   VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{Binding StatusHealthy, Converter={StaticResource StatusToBrush}}" />
                            <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource H2}" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                        <Border Style="{StaticResource Panel}" Margin="0,12,0,0"
                                Visibility="{Binding StatusRecommendation, Converter={StaticResource NullToVis}}">
                            <StackPanel>
                                <TextBlock Text="RECOMMENDATION" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding StatusRecommendation}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- FPS highlight -->
            <Border Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,28,0">
                        <TextBlock Text="FPS" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding FpsDisplay}" Style="{StaticResource MetricBig}"
                                   Foreground="{StaticResource Brush.Accent.Magenta}" />
                        <TextBlock Text="{Binding FrameTimeDisplay}" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <ctrl:LineGraph Grid.Column="1" Height="120" Values="{Binding FpsSeries}"
                                    Stroke="{StaticResource Brush.Accent.Magenta}" />
                </Grid>
            </Border>

            <!-- Metrics -->
            <WrapPanel Margin="0,14,0,0">
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="AVG FPS" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding AverageFps, StringFormat={}{0:0}}" Style="{StaticResource MetricBig}" FontSize="26" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="1% LOW" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding OnePercentLow, StringFormat={}{0:0}}" Style="{StaticResource MetricBig}" FontSize="26" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="0.1% LOW" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding PointOnePercentLow, StringFormat={}{0:0}}" Style="{StaticResource MetricBig}" FontSize="26" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="FRAME TIME" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding FrameTime, StringFormat={}{0:0.0} ms}" Style="{StaticResource MetricBig}" FontSize="26" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="CPU LOAD" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding Cpu, StringFormat={}{0:0} %}" Style="{StaticResource MetricBig}" FontSize="26"
                                   Foreground="{Binding Cpu, Converter={StaticResource PercentToBrush}}" />
                        <TextBlock Text="{Binding CpuTemp, StringFormat=Temp {0:0}\u00B0C}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="GPU LOAD" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding Gpu, StringFormat={}{0:0} %}" Style="{StaticResource MetricBig}" FontSize="26"
                                   Foreground="{Binding Gpu, Converter={StaticResource PercentToBrush}}" />
                        <TextBlock Text="{Binding GpuTemp, StringFormat=Temp {0:0}\u00B0C}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="MEMORY" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding RamPercent, StringFormat={}{0:0} %}" Style="{StaticResource MetricBig}" FontSize="26"
                                   Foreground="{Binding RamPercent, Converter={StaticResource PercentToBrush}}" />
                        <TextBlock Text="{Binding RamText}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="VRAM" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding VramPercent, StringFormat={}{0:0} %}" Style="{StaticResource MetricBig}" FontSize="26"
                                   Foreground="{Binding VramPercent, Converter={StaticResource PercentToBrush}}" />
                        <TextBlock Text="{Binding GpuName}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Graphs -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="FRAME TIME (ms)" Style="{StaticResource MetricLabel}" />
                        <ctrl:LineGraph Height="120" Margin="0,10,0,0" Values="{Binding FrameTimeSeries}"
                                        Stroke="{StaticResource Brush.Accent.Cyan}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CPU / GPU LOAD (%)" Style="{StaticResource MetricLabel}" />
                        <Grid Margin="0,10,0,0" Height="120">
                            <ctrl:LineGraph Values="{Binding CpuSeries}" Stroke="{StaticResource Brush.Ok}" AutoScale="False" MaxValue="100" />
                            <ctrl:LineGraph Values="{Binding GpuSeries}" Stroke="{StaticResource Brush.Accent.Violet}" AutoScale="False" MaxValue="100" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
