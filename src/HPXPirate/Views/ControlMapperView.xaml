<UserControl x:Class="HPXPirate.Views.ControlMapperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Primary}">

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Control Mapper" Style="{StaticResource H1}" />
            <TextBlock Text="Map keyboard and mouse inputs to on-screen control points. Capture keys live, then drag points to position them."
                       Style="{StaticResource Caption}" Margin="0,2,0,16" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: list + tools -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PROFILE" Style="{StaticResource MetricLabel}" />
                    <ComboBox Grid.Row="1" Margin="0,6,0,12" Style="{StaticResource HpxCombo}"
                              ItemsSource="{Binding Profiles}" DisplayMemberPath="Game"
                              SelectedItem="{Binding SelectedProfile}" />

                    <ListBox Grid.Row="2" ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping}"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.Text.Primary}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#14FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#22FF2BD6" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="6" Background="#1AFF2BD6" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Input}" FontFamily="{StaticResource Font.Mono}" FontWeight="Bold"
                                                   Foreground="{StaticResource Brush.Accent.Magenta}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Action}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding InputType}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="+ Key" Margin="0,0,6,6" Command="{Binding AddKeyCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="+ Mouse" Margin="0,0,6,6" Command="{Binding AddMouseCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Remove" Margin="0,0,6,6" Command="{Binding RemoveCommand}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Save" Margin="0,0,6,6" Command="{Binding SaveCommand}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Right: visual editor -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="CAPTURE INPUT" Command="{Binding CaptureCommand}" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,14,0,0" ClipToBounds="True">
                        <Grid>
                            <Image Source="pack://application:,,,/Assets/hpx_logo.png" Stretch="Uniform" Opacity="0.06" />
                            <Canvas x:Name="MapCanvas" Background="Transparent" ClipToBounds="True" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2" Text="Drag any control point to reposition it. Coordinates are stored per profile."
                               Style="{StaticResource Caption}" Margin="0,10,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
