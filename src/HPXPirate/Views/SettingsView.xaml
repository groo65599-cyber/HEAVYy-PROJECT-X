<UserControl x:Class="HPXPirate.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Primary}">

    <UserControl.Resources>
        <Style x:Key="SetLabel" TargetType="TextBlock" BasedOn="{StaticResource MetricLabel}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Settings" Style="{StaticResource H1}" />
            <TextBlock Text="Configure startup, monitoring cadence, safety behaviour and appearance."
                       Style="{StaticResource Caption}" Margin="0,2,0,16" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- General -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="GENERAL" Style="{StaticResource H2}" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Minimize to tray" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Auto-load profiles" IsChecked="{Binding AutoLoadProfiles}" Margin="0,0,0,12" />

                        <TextBlock Text="LANGUAGE" Style="{StaticResource SetLabel}" Margin="0,6,0,6" />
                        <ComboBox Style="{StaticResource HpxCombo}" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />

                        <TextBlock Text="THEME" Style="{StaticResource SetLabel}" Margin="0,14,0,6" />
                        <ComboBox Style="{StaticResource HpxCombo}" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
                    </StackPanel>
                </Border>

                <!-- Performance -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="PERFORMANCE" Style="{StaticResource H2}" Margin="0,0,0,12" />
                        <TextBlock Text="DEFAULT BOOST MODE" Style="{StaticResource SetLabel}" />
                        <ComboBox Style="{StaticResource HpxCombo}" ItemsSource="{Binding Modes}" SelectedItem="{Binding DefaultBoostMode}" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Auto-optimize on game launch" IsChecked="{Binding AutoOptimize}" Margin="0,12,0,12" />

                        <TextBlock Text="MONITORING INTERVAL (ms)" Style="{StaticResource SetLabel}" />
                        <TextBlock Text="{Binding MonitoringIntervalMs, StringFormat={}{0} ms}" Style="{StaticResource Mono}" />
                        <Slider Style="{StaticResource HpxSlider}" Minimum="250" Maximum="5000" Value="{Binding MonitoringIntervalMs}" />

                        <TextBlock Text="IDLE INTERVAL (ms)" Style="{StaticResource SetLabel}" Margin="0,12,0,6" />
                        <TextBlock Text="{Binding IdleMonitoringIntervalMs, StringFormat={}{0} ms}" Style="{StaticResource Mono}" />
                        <Slider Style="{StaticResource HpxSlider}" Minimum="1000" Maximum="15000" Value="{Binding IdleMonitoringIntervalMs}" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Reduce monitoring when idle (saves CPU/RAM)" IsChecked="{Binding ReduceMonitoringWhenIdle}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Safety -->
                <Border Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,14,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="SAFETY &amp; RECOVERY" Style="{StaticResource H2}" Margin="0,0,0,12" />
                        <WrapPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Create restore points before changes" IsChecked="{Binding CreateRestorePoints}" Margin="0,0,24,12" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Backup settings before changes" IsChecked="{Binding BackupBeforeChanges}" Margin="0,0,24,12" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Safe mode" IsChecked="{Binding SafeMode}" Margin="0,0,24,12" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Diagnostic mode" IsChecked="{Binding DiagnosticMode}" Margin="0,0,24,12" />
                        </WrapPanel>
                        <TextBlock Text="Safe mode limits optimizations to the lowest-risk actions. Diagnostic mode writes verbose logs for troubleshooting."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="SAVE SETTINGS" Command="{Binding SaveCommand}" />
            <Button Style="{StaticResource GhostButton}" Content="Create Restore Point" Margin="10,0,0,0" Command="{Binding RestorePointCommand}" />
            <Button Style="{StaticResource DangerButton}" Content="RESET TO DEFAULTS" Margin="10,0,0,0" Command="{Binding ResetCommand}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
