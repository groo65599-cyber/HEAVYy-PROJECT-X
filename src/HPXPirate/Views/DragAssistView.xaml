<UserControl x:Class="HPXPirate.Views.DragAssistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:HPXPirate.Controls"
             FontFamily="{StaticResource Font.Primary}">

    <UserControl.Resources>
        <Style x:Key="SliderLabel" TargetType="TextBlock" BasedOn="{StaticResource MetricLabel}" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,28">
        <StackPanel>
            <TextBlock Text="Drag Assist" Style="{StaticResource H1}" />
            <TextBlock Text="Reshape your own mouse drag for a lighter, smoother, more consistent feel. It only processes your input."
                       Style="{StaticResource Caption}" Margin="0,2,0,18" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <!-- Controls -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Enable Drag Assist" IsChecked="{Binding Enabled}" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,14">
                                <TextBlock Text="DRAG SENSITIVITY" Style="{StaticResource SliderLabel}" />
                                <TextBlock Text="{Binding DragSensitivity, StringFormat={}{0:0.00}}" Style="{StaticResource Mono}" />
                                <Slider Style="{StaticResource HpxSlider}" Minimum="0.1" Maximum="3" Value="{Binding DragSensitivity}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,14">
                                <TextBlock Text="DRAG ACCELERATION" Style="{StaticResource SliderLabel}" />
                                <TextBlock Text="{Binding DragAcceleration, StringFormat={}{0:0.00}}" Style="{StaticResource Mono}" />
                                <Slider Style="{StaticResource HpxSlider}" Minimum="0" Maximum="1" Value="{Binding DragAcceleration}" />
                            </StackPanel>

                            <StackPanel Grid.Column="0" Margin="0,0,12,14">
                                <TextBlock Text="DRAG SMOOTHING" Style="{StaticResource SliderLabel}" />
                                <TextBlock Text="{Binding DragSmoothing, StringFormat={}{0:0.00}}" Style="{StaticResource Mono}" />
                                <Slider Style="{StaticResource HpxSlider}" Minimum="0" Maximum="1" Value="{Binding DragSmoothing}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,14">
                                <TextBlock Text="START ZONE SENSITIVITY" Style="{StaticResource SliderLabel}" />
                                <TextBlock Text="{Binding StartZoneSensitivity, StringFormat={}{0:0.00}}" Style="{StaticResource Mono}" />
                                <Slider Style="{StaticResource HpxSlider}" Minimum="0.2" Maximum="3" Value="{Binding StartZoneSensitivity}" />
                            </StackPanel>

                            <StackPanel Grid.Column="0" Margin="0,0,12,14">
                                <TextBlock Text="VERTICAL MULTIPLIER" Style="{StaticResource SliderLabel}" />
                                <TextBlock Text="{Binding VerticalMultiplier, StringFormat={}{0:0.00}}" Style="{StaticResource Mono}" />
                                <Slider Style="{StaticResource HpxSlider}" Minimum="0.2" Maximum="2" Value="{Binding VerticalMultiplier}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,14">
                                <TextBlock Text="HORIZONTAL MULTIPLIER" Style="{StaticResource SliderLabel}" />
                                <TextBlock Text="{Binding HorizontalMultiplier, StringFormat={}{0:0.00}}" Style="{StaticResource Mono}" />
                                <Slider Style="{StaticResource HpxSlider}" Minimum="0.2" Maximum="2" Value="{Binding HorizontalMultiplier}" />
                            </StackPanel>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="DRAG DISTANCE" Style="{StaticResource SliderLabel}" />
                                <TextBlock Text="{Binding DragDistance, StringFormat={}{0:0}}" Style="{StaticResource Mono}" />
                                <Slider Style="{StaticResource HpxSlider}" Minimum="10" Maximum="400" Value="{Binding DragDistance}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="DRAG SPEED" Style="{StaticResource SliderLabel}" />
                                <TextBlock Text="{Binding DragSpeed, StringFormat={}{0:0.00}}" Style="{StaticResource Mono}" />
                                <Slider Style="{StaticResource HpxSlider}" Minimum="0.2" Maximum="3" Value="{Binding DragSpeed}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="SAVE" Command="{Binding SaveCommand}" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Curve -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="RESPONSE CURVE" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding CurveName}" Style="{StaticResource Mono}" Margin="0,4,0,0"
                                   Foreground="{StaticResource Brush.Accent.Magenta}" />
                        <ctrl:LineGraph Height="150" Margin="0,12,0,0" Values="{Binding Curve}"
                                        Stroke="{StaticResource Brush.Accent.Cyan}" AutoScale="False" MaxValue="100" />

                        <WrapPanel Margin="0,14,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Linear" Margin="0,0,6,6" Command="{Binding LinearCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Smooth" Margin="0,0,6,6" Command="{Binding SmoothCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Fast Start" Margin="0,0,6,6" Command="{Binding FastCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Slow Start" Margin="0,0,6,6" Command="{Binding SlowCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Precision" Margin="0,0,6,6" Command="{Binding PrecisionCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Custom" Margin="0,0,6,6" Command="{Binding CustomCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
