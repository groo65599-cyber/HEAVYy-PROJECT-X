<UserControl x:Class="HPXPirate.Views.GameProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:models="clr-namespace:HPXPirate.Models"
             FontFamily="{StaticResource Font.Primary}">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="Modes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:OptimizationMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Game Profiles" Style="{StaticResource H1}" />
            <TextBlock Text="Per-game settings: performance mode, mouse feel, Easy Drag, crosshair and key mapping."
                       Style="{StaticResource Caption}" Margin="0,2,0,16" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Profile list -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PROFILES" Style="{StaticResource MetricLabel}" Margin="0,0,0,8" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.Text.Primary}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#14FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#22FF2BD6" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Game}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Resolution}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="New" Margin="0,0,6,6" Command="{Binding NewCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Duplicate" Margin="0,0,6,6" Command="{Binding DuplicateCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Delete" Margin="0,0,6,6" Command="{Binding DeleteCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Import" Margin="0,0,6,6" Command="{Binding ImportCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Backup" Margin="0,0,6,6" Command="{Binding BackupCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Restore" Margin="0,0,6,6" Command="{Binding RestoreCommand}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Editor -->
            <Border Grid.Column="1" Style="{StaticResource Card}"
                    Visibility="{Binding SelectedProfile, Converter={StaticResource NullToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="PROFILE DETAILS" Style="{StaticResource MetricLabel}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="GAME NAME" Style="{StaticResource MetricLabel}" />
                                <TextBox Style="{StaticResource HpxTextBox}" Margin="0,6,0,0"
                                         Text="{Binding SelectedProfile.Game, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,12">
                                <TextBlock Text="EXECUTABLE PATH" Style="{StaticResource MetricLabel}" />
                                <TextBox Style="{StaticResource HpxTextBox}" Margin="0,6,0,0"
                                         Text="{Binding SelectedProfile.ExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="RESOLUTION" Style="{StaticResource MetricLabel}" />
                                <TextBox Style="{StaticResource HpxTextBox}" Margin="0,6,0,0"
                                         Text="{Binding SelectedProfile.Resolution, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,10,12">
                                <TextBlock Text="FPS TARGET" Style="{StaticResource MetricLabel}" />
                                <TextBox Style="{StaticResource HpxTextBox}" Margin="0,6,0,0"
                                         Text="{Binding SelectedProfile.FpsTarget, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0,0,12">
                                <TextBlock Text="PERFORMANCE MODE" Style="{StaticResource MetricLabel}" />
                                <ComboBox Style="{StaticResource HpxCombo}" Margin="0,6,0,0"
                                          ItemsSource="{Binding Source={StaticResource Modes}}"
                                          SelectedItem="{Binding SelectedProfile.PerformanceMode}" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="MOUSE SENSITIVITY" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding SelectedProfile.MouseSensitivity, StringFormat={}{0:0.00}}" Style="{StaticResource Mono}" Margin="0,4,0,0" />
                                <Slider Style="{StaticResource HpxSlider}" Minimum="0.1" Maximum="5" Value="{Binding SelectedProfile.MouseSensitivity}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="DRAG SENSITIVITY" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding SelectedProfile.DragSensitivity, StringFormat={}{0:0.00}}" Style="{StaticResource Mono}" Margin="0,4,0,0" />
                                <Slider Style="{StaticResource HpxSlider}" Minimum="0.1" Maximum="5" Value="{Binding SelectedProfile.DragSensitivity}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Auto-load the matching profile when a game starts"
                                  IsChecked="{Binding AutoLoad}" Margin="0,18,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="SAVE" Command="{Binding SaveCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Apply to App" Margin="10,0,0,0" Command="{Binding ApplyCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Reset" Margin="10,0,0,0" Command="{Binding ResetCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Export" Margin="10,0,0,0" Command="{Binding ExportCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
