<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ HPX PIRATE — Cyberpunk Dark Palette ============ -->

    <!-- Base surfaces -->
    <Color x:Key="Color.Bg.Deep">#FF07060B</Color>
    <Color x:Key="Color.Bg.Base">#FF0D0B14</Color>
    <Color x:Key="Color.Bg.Panel">#FF14111F</Color>
    <Color x:Key="Color.Bg.Card">#FF1A1626</Color>
    <Color x:Key="Color.Bg.CardHover">#FF221C33</Color>
    <Color x:Key="Color.Bg.Sidebar">#FF0A0812</Color>
    <Color x:Key="Color.Border">#FF2C2440</Color>
    <Color x:Key="Color.Border.Glow">#FF3A2F55</Color>

    <!-- Brand accents -->
    <Color x:Key="Color.Accent.Magenta">#FFFF2BD6</Color>
    <Color x:Key="Color.Accent.MagentaDeep">#FFC400A8</Color>
    <Color x:Key="Color.Accent.Cyan">#FF2BE7FF</Color>
    <Color x:Key="Color.Accent.Silver">#FFD7DCE6</Color>
    <Color x:Key="Color.Accent.Violet">#FF8A5CFF</Color>

    <!-- Status -->
    <Color x:Key="Color.Ok">#FF35E08A</Color>
    <Color x:Key="Color.Warn">#FFFFB020</Color>
    <Color x:Key="Color.Bad">#FFFF4D6D</Color>

    <!-- Text -->
    <Color x:Key="Color.Text.Primary">#FFEDEAF6</Color>
    <Color x:Key="Color.Text.Secondary">#FF9C93B8</Color>
    <Color x:Key="Color.Text.Muted">#FF6B6485</Color>

    <!-- ============ Brushes ============ -->
    <SolidColorBrush x:Key="Brush.Bg.Deep" Color="{StaticResource Color.Bg.Deep}" />
    <SolidColorBrush x:Key="Brush.Bg.Base" Color="{StaticResource Color.Bg.Base}" />
    <SolidColorBrush x:Key="Brush.Bg.Panel" Color="{StaticResource Color.Bg.Panel}" />
    <SolidColorBrush x:Key="Brush.Bg.Card" Color="{StaticResource Color.Bg.Card}" />
    <SolidColorBrush x:Key="Brush.Bg.CardHover" Color="{StaticResource Color.Bg.CardHover}" />
    <SolidColorBrush x:Key="Brush.Bg.Sidebar" Color="{StaticResource Color.Bg.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Border.Glow" Color="{StaticResource Color.Border.Glow}" />

    <SolidColorBrush x:Key="Brush.Accent.Magenta" Color="{StaticResource Color.Accent.Magenta}" />
    <SolidColorBrush x:Key="Brush.Accent.MagentaDeep" Color="{StaticResource Color.Accent.MagentaDeep}" />
    <SolidColorBrush x:Key="Brush.Accent.Cyan" Color="{StaticResource Color.Accent.Cyan}" />
    <SolidColorBrush x:Key="Brush.Accent.Silver" Color="{StaticResource Color.Accent.Silver}" />
    <SolidColorBrush x:Key="Brush.Accent.Violet" Color="{StaticResource Color.Accent.Violet}" />

    <SolidColorBrush x:Key="Brush.Ok" Color="{StaticResource Color.Ok}" />
    <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}" />
    <SolidColorBrush x:Key="Brush.Bad" Color="{StaticResource Color.Bad}" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" />

    <!-- Gradients -->
    <LinearGradientBrush x:Key="Brush.Brand.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFF2BD6" Offset="0" />
        <GradientStop Color="#FF8A5CFF" Offset="0.55" />
        <GradientStop Color="#FF2BE7FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Card.Gradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1E1830" Offset="0" />
        <GradientStop Color="#FF141020" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Boost.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFF2BD6" Offset="0" />
        <GradientStop Color="#FFB020FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Sidebar.Gradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF0C0A16" Offset="0" />
        <GradientStop Color="#FF08060F" Offset="1" />
    </LinearGradientBrush>

    <!-- Fonts -->
    <FontFamily x:Key="Font.Primary">Segoe UI Variable Display, Segoe UI, Inter, Arial</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Code, Consolas, JetBrains Mono, Courier New</FontFamily>

</ResourceDictionary>
