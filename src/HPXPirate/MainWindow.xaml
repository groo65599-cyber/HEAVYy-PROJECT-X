<Window x:Class="HPXPirate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="HPX PIRATE"
        Width="1340" Height="860" MinWidth="1140" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg.Deep}"
        Foreground="{StaticResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Primary}"
        WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Window control buttons -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4D6D" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Background="{StaticResource Brush.Bg.Deep}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= TITLE BAR ================= -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource Brush.Sidebar.Gradient}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Brush.Brand.Gradient}">
                            <Image Source="pack://application:,,,/Assets/hpx_logo.png" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Text="HPX PIRATE" Margin="12,0,0,0" VerticalAlignment="Center"
                                   FontSize="16" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" />
                        <TextBlock Text="//" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.Accent.Magenta}" />
                        <TextBlock x:Name="BreadcrumbText" Text="Dashboard" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WinBtn}" Content="&#xE921;" ToolTip="Minimise" Click="Minimise_Click" />
                        <Button Style="{StaticResource WinBtn}" Content="&#xE922;" ToolTip="Maximise" Click="Maximise_Click" />
                        <Button Style="{StaticResource WinCloseBtn}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= SIDEBAR ================= -->
            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Brush.Sidebar.Gradient}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,10">
                        <StackPanel>
                            <TextBlock Text="PERFORMANCE CENTER" Margin="20,6,0,8" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Text.Muted}" />

                            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="dashboard" IsChecked="True" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" VerticalAlignment="Center" />
                                    <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="performance" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" VerticalAlignment="Center" />
                                    <TextBlock Text="Performance" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="profiles" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" VerticalAlignment="Center" />
                                    <TextBlock Text="Game Profiles" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="mapper" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" VerticalAlignment="Center" />
                                    <TextBlock Text="Control Mapper" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="dragassist" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE962;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" VerticalAlignment="Center" />
                                    <TextBlock Text="Drag Assist" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="easydrag" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" VerticalAlignment="Center" />
                                    <TextBlock Text="Easy Drag Lab" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="crosshair" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" VerticalAlignment="Center" />
                                    <TextBlock Text="Crosshair" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="monitor" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" VerticalAlignment="Center" />
                                    <TextBlock Text="Monitor" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="optimizer" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" VerticalAlignment="Center" />
                                    <TextBlock Text="System Optimizer" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="settings" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" VerticalAlignment="Center" />
                                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- footer -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Brush.Ok}" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusText" Text="Monitoring active" Margin="8,0,0,0" FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="HPX PIRATE v1.0.0" Margin="0,6,0,0" FontSize="10"
                                       Foreground="{StaticResource Brush.Text.Muted}" />
                            <TextBlock Text="Fair-play build — no aim assist" FontSize="10"
                                       Foreground="{StaticResource Brush.Text.Muted}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= CONTENT ================= -->
            <Grid Grid.Row="1" Grid.Column="1" Background="{StaticResource Brush.Bg.Base}">
                <ContentControl x:Name="ContentHost" />
            </Grid>
        </Grid>
    </Border>
</Window>
